# Server-only values. Never commit .env.local or paste credentials into chat.
# Supabase Connect > session pooler (5432), or transaction pooler for runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"
# Optional when DATABASE_URL is already a session/direct connection suitable for migrations.
# Required if DATABASE_URL uses transaction pooling (6543).
DIRECT_URL=""
# Supabase Database Settings > SSL Configuration > Download Certificate.
DATABASE_CA_CERT_PATH="./certs/supabase-ca.crt"
# Vercel: set DATABASE_CA_CERT to the complete PEM certificate contents instead.
# Leave DATABASE_CA_CERT_PATH unset there; certs/ is intentionally not committed.
# Both actual newlines and literal \n sequences are accepted. Never use a private key.
DATABASE_CA_CERT=""
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES"
BETTER_AUTH_URL="http://localhost:3000"
# Optional separate test database. When empty, tests create/drop a random isolated
# schema through DIRECT_URL and never modify the application's tradesim schema.
TEST_DATABASE_URL=""
# Required with TEST_DATABASE_URL: restricted tradesim_runtime role in that DB.
TEST_RUNTIME_DATABASE_URL=""
